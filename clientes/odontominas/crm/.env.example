# Evolution API (WhatsApp) — ver _contexto/ferramentas.md
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_TOKEN=
# Nome da instância (default no código: "odontominas-teste"). Só precisa
# setar se a instância mudar de nome.
EVOLUTION_INSTANCE=

# Segredo do cron de reativação de paciente inativo (Fase 5, ver
# src/app/api/cron/reativacao). Mesmo valor tem que estar no secret do
# GitHub Actions que dispara o cron (.github/workflows/).
CRON_SECRET=

# Supabase — projeto dedicado deste CRM (odontominas-crm)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Login do painel — 1 conta por atendente na tabela `atendentes` (ver
# supabase/migrations/2026-09-15_v4_equipe.sql), não senha única em env var.
# SESSAO_SECRET: string aleatória longa (ex: `openssl rand -base64 32`), só
# pra assinar o cookie de sessão.
SESSAO_SECRET=

# Agentes de IA (src/lib/ia-provedores.ts) — todas opcionais, cada uma liga
# um provedor no seletor de modelo em /agentes. Sem nenhuma setada, a tela
# funciona normalmente, só não tem modelo pra escolher.
GOOGLE_API_KEY=       # Gemini — grátis via Google AI Studio (sem cartão)
GROQ_API_KEY=         # Groq — grátis, modelos Llama
OPENAI_API_KEY=       # GPT — pago
ANTHROPIC_API_KEY=    # Claude — pago
DEEPSEEK_API_KEY=     # DeepSeek — pago (bem barato)

# Pixel de Conversão (src/lib/pixel-google-ads.ts) — 1 app OAuth do Google
# Cloud da própria Noryos, reaproveitado por qualquer cliente (Customer ID,
# Login Customer ID e o Refresh Token de cada um ficam no formulário do
# agente, aba Pixel — não aqui). Sem isso setado, o disparo pro Google Ads
# falha silenciosamente (log, nunca derruba o fluxo principal); Facebook não
# precisa de nada aqui (Pixel ID + Access Token já são por-agente).
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=

# Integração ControleODONTO (src/lib/controle-odonto/, ver
# docs/integrations/controle-odonto.md) — nasce desligada. Sem
# CONTROLE_ODONTO_BASE_URL preenchida, a integração fica "não configurada"
# e nenhuma chamada externa é feita. Autenticação ainda não tem mecanismo
# confirmado publicamente — mesmo com tudo abaixo preenchido, as
# capabilities de leitura/escrita só ligam depois de alguém validar contra
# uma conta real e mudar src/lib/controle-odonto/capabilities.ts na mão.
CONTROLE_ODONTO_ENABLED=false
CONTROLE_ODONTO_BASE_URL=
CONTROLE_ODONTO_ESTABELECIMENTO_ID=
CONTROLE_ODONTO_SYNC_ENABLED=false
CONTROLE_ODONTO_SYNC_INTERVAL_MINUTES=5
CONTROLE_ODONTO_SYNC_MARGEM_HORAS=24
CONTROLE_ODONTO_SYNC_HORIZONTE_DIAS=30
